  dc.clearRect(0,0,W,H);
  const bg=dc.createLinearGradient(0,0,W,H);
  bg.addColorStop(0,'rgba(6,3,10,1)');bg.addColorStop(0.5,'rgba(9,4,14,1)');bg.addColorStop(1,'rgba(6,3,10,1)');
  dc.fillStyle=bg;dc.fillRect(0,0,W,H);
  if(mouse.x>-100){const mg=dc.createRadialGradient(mouse.x,mouse.y,0,mouse.x,mouse.y,280);mg.addColorStop(0,'rgba(217,70,239,0.08)');mg.addColorStop(0.5,'rgba(168,85,247,0.03)');mg.addColorStop(1,'transparent');dc.fillStyle=mg;dc.fillRect(0,0,W,H);}
  scanPhase+=0.003;scanPhase2+=0.007;
  const sY=((Math.sin(scanPhase)*0.5+0.5)*H);
  const sY2=((Math.cos(scanPhase2)*0.5+0.5)*H);
  const sGrad=dc.createLinearGradient(0,sY-3,0,sY+3);sGrad.addColorStop(0,'transparent');sGrad.addColorStop(0.5,'rgba(217,70,239,0.25)');sGrad.addColorStop(1,'transparent');dc.fillStyle=sGrad;dc.fillRect(0,sY-3,W,6);
  const sGrad2=dc.createLinearGradient(0,sY2-2,0,sY2+2);sGrad2.addColorStop(0,'transparent');sGrad2.addColorStop(0.5,'rgba(239,68,68,0.12)');sGrad2.addColorStop(1,'transparent');dc.fillStyle=sGrad2;dc.fillRect(0,sY2-2,W,4);
  scheduleHl();
  docLines.forEach(l=>{
    const prox=Math.max(0,1-Math.abs(l.y-mouse.y)/80)*0.05;
    const scanP=Math.max(0,1-Math.abs(l.y-sY)/28)*0.12;
    if(l.hlActive){l.hlTimer+=0.04;const hA=Math.max(0,1-l.hlTimer/1.8);const hC=l.hlColor==='mid'?'rgba(217,70,239,':'rgba(239,68,68,';dc.fillStyle=hC+(hA*0.11)+')';dc.globalAlpha=1;dc.fillRect(l.x-4,l.y-5,l.w+8,10);dc.fillStyle=hC+(hA*0.65)+')';dc.fillRect(l.x,l.y,l.w*Math.min(1,l.hlTimer*0.8),1);if(l.hlTimer>1.8){l.hlActive=false;l.hlTimer=0;}}
    dc.globalAlpha=l.alpha+prox+scanP;
    if(l.isHdr){dc.fillStyle='rgba(232,121,249,0.6)';dc.fillRect(l.x,l.y,l.w*0.46,1.5);dc.fillStyle='rgba(168,85,247,0.45)';dc.beginPath();dc.arc(l.x-8,l.y+0.5,2,0,Math.PI*2);dc.fill();}
    else if(l.isInd){dc.fillStyle='rgba(168,85,247,0.32)';dc.fillRect(l.x,l.y,l.w,0.7);}
    else{dc.fillStyle='rgba(120,90,160,0.4)';dc.fillRect(l.x,l.y,l.w,0.8);}
  });
  failureNodes.forEach(n=>{
    if(!n.active&&t>n.activateAt)n.active=true;
    if(!n.active)return;
    n.alpha=Math.min(n.targetAlpha,n.alpha+0.004);
    const pulse=0.5+0.5*Math.sin(t*1.8+n.phase);
    const col=n.sev==='critical'?'#ef4444':n.sev==='major'?'#d946ef':'#a855f7';
    dc.globalAlpha=n.alpha*(0.7+0.3*pulse);
    dc.fillStyle=col;dc.shadowColor=col;dc.shadowBlur=n.sev==='critical'?14:8;
    dc.beginPath();dc.arc(n.x,n.y,n.r,0,Math.PI*2);dc.fill();
    dc.globalAlpha=n.alpha*pulse*0.22;dc.strokeStyle=col;dc.lineWidth=0.8;
    dc.beginPath();dc.arc(n.x,n.y,n.r+4+pulse*4,0,Math.PI*2);dc.stroke();
    dc.shadowBlur=0;
  });
  dc.lineWidth=0.5;
  for(let i=0;i<failureNodes.length;i++){
    if(!failureNodes[i].active)continue;
    for(let j=i+1;j<failureNodes.length;j++){
      if(!failureNodes[j].active)continue;
      const d=Math.hypot(failureNodes[i].x-failureNodes[j].x,failureNodes[i].y-failureNodes[j].y);
      if(d<130){const isCrit=failureNodes[i].sev==='critical'||failureNodes[j].sev==='critical';dc.globalAlpha=(1-d/130)*0.13*failureNodes[i].alpha;dc.strokeStyle=isCrit?'rgba(239,68,68,0.8)':'rgba(217,70,239,0.7)';dc.beginPath();dc.moveTo(failureNodes[i].x,failureNodes[i].y);dc.lineTo(failureNodes[j].x,failureNodes[j].y);dc.stroke();}
    }
  }
  const active=failureNodes.filter(n=>n.active).length;
  const crit=failureNodes.filter(n=>n.active&&n.sev==='critical').length;
  if(active>0){dc.globalAlpha=0.16;dc.font="9px 'JetBrains Mono',monospace";dc.fillStyle=crit>0?'#ef4444':'#d946ef';dc.textAlign='left';dc.fillText(`∂ SCAN ACTIVE · ${active} NODES · ${crit} CRITICAL`,22,H-22);}
  dc.globalAlpha=1;dc.shadowBlur=0;
}

const SYMS=['∇','Σ','∫','∂','λ','⊕','⊗','∈','∀','∃','⊢','⊨','→','↔','∧','∨','¬','≡','≈','≠','≤','≥','∞','∝','Δ','Π','Ω','α','β','γ','δ','ε','θ','μ','σ','φ','ψ','ω','∄','⁂','◈'];
const MCOLS=['#d946ef','#e879f9','#a855f7','#c084fc','#f0abfc'];
const GR=180,GS=0.018,TG=0.22;
const PFPS=lowDevice?30:60,PDT=1000/PFPS;
let symbols=[],echoes=[];
function initSymbols(){
  symbols=[];const n=Math.floor((W*H)/7000);
  for(let i=0;i<n;i++)symbols.push({char:SYMS[Math.floor(Math.random()*SYMS.length)],x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.25,vy:(Math.random()-.5)*.25,size:11+Math.random()*18,alpha:0.10+Math.random()*0.20,inWell:false,scrollGlow:0,phase:Math.random()*Math.PI*2,origX:0,origY:0,targetX:0,targetY:0});
}
function updateSymbols(){
  mouse.vx=mouse.x-mouse.prevX;mouse.vy=mouse.y-mouse.prevY;mouse.prevX=mouse.x;mouse.prevY=mouse.y;
  symbols.forEach(s=>{
    s.x+=s.vx;s.y+=s.vy;
    if(s.x<-40)s.x=W+40;if(s.x>W+40)s.x=-40;if(s.y<-40)s.y=H+40;if(s.y>H+40)s.y=-40;
    if(mouse.x>-100){const dx=s.x-mouse.x,dy=s.y-mouse.y,d=Math.hypot(dx,dy);if(d<GR&&d>1){const f=GS*(1-d/GR),a=Math.atan2(dy,dx);s.vx-=Math.cos(a)*f;s.vy-=Math.sin(a)*f;const ta=a+Math.PI/2,sp=TG*(1-d/GR);s.vx+=Math.cos(ta)*sp*(mouse.vx*.04+.5);s.vy+=Math.sin(ta)*sp*(mouse.vy*.04+.5);s.vx*=.985;s.vy*=.985;s.inWell=true;}else{s.inWell=false;s.vx*=.998;s.vy*=.998;}}else{s.inWell=false;}
    if(s.scrollGlow>0.01)s.scrollGlow*=.93;else s.scrollGlow=0;
  });
}
function spawnEcho(x,y){for(let i=0;i<10;i++){const a=(Math.PI*2*i)/10+Math.random()*.4,sp=1.5+Math.random()*2.5;echoes.push({char:SYMS[Math.floor(Math.random()*SYMS.length)],x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,size:9+Math.random()*8,color:MCOLS[Math.floor(Math.random()*MCOLS.length)],alpha:0.8,age:0,maxAge:500});}}
function updateEchoes(){echoes=echoes.filter(e=>{e.age+=16;if(e.age>=e.maxAge)return false;e.x+=e.vx;e.y+=e.vy;e.alpha=0.8*(1-e.age/e.maxAge);e.vx*=.97;e.vy*=.97;return true;});}
function drawSymbols(){
  sc.clearRect(0,0,W,H);
  echoes.forEach(e=>{sc.globalAlpha=e.alpha;sc.font=`${e.size}px 'JetBrains Mono',monospace`;sc.textAlign='center';sc.textBaseline='middle';sc.shadowColor=e.color;sc.shadowBlur=12;sc.fillStyle=e.color;sc.fillText(e.char,e.x,e.y);});
  symbols.forEach(s=>{
    const glow=s.scrollGlow>.01?14+s.scrollGlow*18:s.inWell?22:10;
    sc.font=`${s.size}px 'JetBrains Mono',monospace`;sc.textAlign='center';sc.textBaseline='middle';
    const isMid=Math.sin(t*.3+s.phase)>0;
    sc.shadowColor=isMid?'#d946ef':'#a855f7';sc.shadowBlur=glow;
    const a=Math.min(0.85,s.alpha+s.scrollGlow*.2);
    sc.fillStyle=isMid?`rgba(217,70,239,${a.toFixed(3)})`:`rgba(168,85,247,${a.toFixed(3)})`;
    sc.globalAlpha=1;sc.fillText(s.char,s.x,s.y);
  });
  sc.shadowBlur=0;sc.globalAlpha=1;
}

let isCollapsing=false,collapsePhase=0,collapseStart=0;
const SNAP=1500,HOLD=800,EXPLODE=600;let holdTO=null;
function triggerCollapse(){
  if(isCollapsing)return;isCollapsing=true;collapsePhase=1;collapseStart=performance.now();
  const lat=[],hW=60,hH=hW*Math.sqrt(3)/2;
  for(let y=0;y<H+hH;y+=hH)for(let x=0;x<W+hW;x+=hW)lat.push({x:x+(Math.floor(y/hH)%2)*(hW/2),y});
  symbols.forEach(s=>{s.origX=s.x;s.origY=s.y;const tg=lat[Math.floor(Math.random()*lat.length)];s.targetX=tg.x;s.targetY=tg.y;});
}
function stepCollapse(now){
  if(!isCollapsing)return;const el=now-collapseStart;
  if(collapsePhase===1){const p=Math.min(el/SNAP,1),tt=1-Math.pow(1-p,3);symbols.forEach(s=>{s.x=s.origX+(s.targetX-s.origX)*tt;s.y=s.origY+(s.targetY-s.origY)*tt;s.vx=0;s.vy=0;s.alpha=0.1+0.38*p;});if(p>=1){collapsePhase=2;collapseStart=now;clearTimeout(holdTO);holdTO=setTimeout(()=>{if(!isCollapsing)return;collapsePhase=3;collapseStart=performance.now();symbols.forEach(s=>{const a=Math.random()*Math.PI*2,sp=3+Math.random()*4;s.vx=Math.cos(a)*sp;s.vy=Math.sin(a)*sp;s.alpha=0.65;});spawnEcho(W/2,H/2);},HOLD);}}
  else if(collapsePhase===3){const p=Math.min(el/EXPLODE,1);symbols.forEach(s=>{s.alpha=0.1+0.22*(1-p);s.vx*=.98;s.vy*=.98;});if(p>=1){isCollapsing=false;collapsePhase=0;symbols.forEach(s=>{s.vx=(Math.random()-.5)*.25;s.vy=(Math.random()-.5)*.25;s.alpha=0.10+Math.random()*.20;});}}
}

let lastPT=0;
function loop(ts){
  t+=0.016;
  if(ts-lastPT>=PDT){lastPT=ts;if(isCollapsing)stepCollapse(ts);else updateSymbols();updateEchoes();}
  drawDocField();drawSymbols();
  requestAnimationFrame(loop);
}
function resize(){W=docCanvas.width=symCanvas.width=window.innerWidth;H=docCanvas.height=symCanvas.height=window.innerHeight;buildDocField();initSymbols();}
let rT;window.addEventListener('resize',()=>{clearTimeout(rT);rT=setTimeout(resize,150);});

window.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'){mouse.x=e.clientX;mouse.y=e.clientY;}});
window.addEventListener('pointerleave',()=>{mouse.x=-9999;mouse.y=-9999;});
window.addEventListener('pointerdown',e=>{if(e.pointerType!=='mouse')return;spawnEcho(e.clientX,e.clientY);const near=failureNodes.find(n=>Math.hypot(n.x-e.clientX,n.y-e.clientY)<50&&!n.active);if(near){near.active=true;near.alpha=near.targetAlpha;}});
window.addEventListener('dblclick',e=>{const tag=e.target.tagName.toLowerCase();const inter=['a','button','input','select','textarea'].includes(tag)||e.target.closest('a')||e.target.closest('button')||e.target.closest('.cta-btn')||e.target.closest('.card')||e.target.closest('.privacy-card');if(!inter)triggerCollapse();});
window.addEventListener('keydown',e=>{if(e.ctrlKey&&e.shiftKey&&e.key==='Q'){e.preventDefault();triggerCollapse();}});
let stimer;window.addEventListener('scroll',()=>{const sy=window.scrollY;symbols.forEach(s=>{if(Math.abs(s.y-(sy+H/2))<180)s.scrollGlow=1.0;});clearTimeout(stimer);stimer=setTimeout(()=>symbols.forEach(s=>s.scrollGlow=0),300);},{passive:true});

const hamburger=document.getElementById('hamburger'),mobileNav=document.getElementById('mobileNav');let navOpen=false;
if(hamburger&&mobileNav){document.querySelectorAll('.nav-links a').forEach((link,i)=>{const a=document.createElement('a');a.href=link.getAttribute('href');a.textContent=link.textContent;if(link.getAttribute('target'))a.setAttribute('target',link.getAttribute('target'));if(link.getAttribute('rel'))a.setAttribute('rel',link.getAttribute('rel'));if(link.classList.contains('active'))a.classList.add('active');a.style.transitionDelay=`${i*30}ms`;mobileNav.appendChild(a);});
function openMenu(){navOpen=true;mobileNav.classList.add('open');mobileNav.setAttribute('aria-hidden','false');hamburger.classList.add('open');hamburger.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';setTimeout(()=>{const f=mobileNav.querySelector('a');if(f)f.focus();},100);}
function closeMenu(){navOpen=false;mobileNav.classList.remove('open');mobileNav.setAttribute('aria-hidden','true');hamburger.classList.remove('open');hamburger.setAttribute('aria-expanded','false');document.body.style.overflow='';hamburger.focus();}
hamburger.addEventListener('click',()=>navOpen?closeMenu():openMenu());mobileNav.addEventListener('click',e=>{if(e.target.tagName==='A')closeMenu();});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&navOpen)closeMenu();});mobileNav.addEventListener('keydown',e=>{if(e.key!=='Tab')return;const f=Array.from(mobileNav.querySelectorAll('a'));if(!f.length)return;if(e.shiftKey&&document.activeElement===f[0]){e.preventDefault();f[f.length-1].focus();}else if(!e.shiftKey&&document.activeElement===f[f.length-1]){e.preventDefault();f[0].focus();}});}

let audioCtx=null,audioOn=false;
const toggle=document.getElementById('audio-toggle');
function initAudio(){const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;audioCtx=new AC();const gain=audioCtx.createGain();gain.gain.setValueAtTime(0.055,audioCtx.currentTime);const filter=audioCtx.createBiquadFilter();filter.type='lowpass';filter.frequency.value=280;filter.Q.value=0.8;const osc1=audioCtx.createOscillator();osc1.type='sine';osc1.frequency.setValueAtTime(38,audioCtx.currentTime);const osc2=audioCtx.createOscillator();osc2.type='sawtooth';osc2.frequency.setValueAtTime(76.4,audioCtx.currentTime);const g2=audioCtx.createGain();g2.gain.setValueAtTime(0.1,audioCtx.currentTime);osc1.connect(filter);osc2.connect(g2);g2.connect(filter);filter.connect(gain);gain.connect(audioCtx.destination);osc1.start();osc2.start();window.addEventListener('pagehide',()=>{try{audioCtx.close();}catch(_){}},{once:true});}
if(toggle){toggle.addEventListener('click',()=>{audioOn=!audioOn;toggle.setAttribute('aria-pressed',String(audioOn));if(audioOn){if(!audioCtx)initAudio();else if(audioCtx.state==='suspended')audioCtx.resume();}else{if(audioCtx&&audioCtx.state==='running')audioCtx.suspend();}});}

document.getElementById('copyright-year').textContent=new Date().getFullYear();
if(!reducedMotion){resize();setTimeout(()=>symCanvas.classList.add('ready'),300);requestAnimationFrame(loop);}
})();
</script>
